{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermVista",
  "version": "0.0.2",
  "identifier": "com.aisshstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermVista",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/termvista-v2/32x32.png",
      "icons/termvista-v2/128x128.png",
      "icons/termvista-v2/128x128@2x.png",
      "icons/termvista-v2/icon.icns",
      "icons/termvista-v2/icon.ico"
    ]
  }
}
