{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermVista",
  "version": "0.1.0",
  "identifier": "com.aisshstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermVista",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/termvista-v2/32x32.png",
      "icons/termvista-v2/128x128.png",
      "icons/termvista-v2/128x128@2x.png",
      "icons/termvista-v2/icon.icns",
      "icons/termvista-v2/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQzY3MEU2QkFFOTM0NTYKUldSV05PbTY1bkRHUTltVmZtUVdaQy9DMUttVHpEdVVpSm11QjdIR0NmMnZzZ0M3bkxvOHArUS8K",
      "endpoints": [
        "https://github.com/auyang/TermVista/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
