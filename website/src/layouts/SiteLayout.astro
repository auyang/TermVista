---
import '../styles/generated.css';
import type { Locale } from '../data/copy';

interface Props {
  lang: string;
  title: string;
  description: string;
  canonicalPath: string;
  locales: Record<Locale, string>;
}

const { lang, title, description, canonicalPath, locales } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteBase = 'https://auyang.github.io/TermVista';
const canonical = `${siteBase}${canonicalPath}`;
const image = `${siteBase}/screenshots/connected-workspace.jpg`;
const localeTags: Record<Locale, string> = { en: 'en-US', 'zh-cn': 'zh-CN', ja: 'ja-JP', 'zh-tw': 'zh-TW' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafb" />
    <link rel="icon" type="image/png" href={`${base}/brand/termvista-icon.png`} />
    <link rel="canonical" href={canonical} />
    {Object.entries(locales).map(([locale, path]) => <link rel="alternate" hreflang={localeTags[locale as Locale]} href={`${siteBase}${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={siteBase + '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TermVista" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
